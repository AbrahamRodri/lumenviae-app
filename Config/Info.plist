<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Partial Info.plist, merged with the keys Xcode generates from the
	  INFOPLIST_KEY_* build settings (GENERATE_INFOPLIST_FILE stays YES).

	  UIBackgroundModes lives here because it CANNOT be expressed as a build
	  setting: INFOPLIST_KEY_UIBackgroundModes is not one of the ~95 keys Xcode
	  recognizes, so it was silently dropped and never reached the binary —
	  narration died the moment the phone locked. Verify after any build with:
	    /usr/libexec/PlistBuddy -c 'Print :UIBackgroundModes' <built>/app.app/Info.plist
	  It must print an array containing "audio".
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
