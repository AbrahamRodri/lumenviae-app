{
  "id": "ecce_panis",
  "part": null,
  "method": "breaths by loudness (under -18 dB for 0.2 s, phrases under 1.5 s merged) + text alignment; Whisper: 14 of 18 breaks heard",
  "lines": [
    {
      "latin": "Ecce panis Angelórum,",
      "english": "Behold the Bread of Angels,",
      "start": 0.21,
      "end": 4.56
    },
    {
      "latin": "Factus cibus viatórum:",
      "english": "made the food of wayfarers,",
      "start": 4.75,
      "end": 9.05
    },
    {
      "latin": "Vere panis filiórum,",
      "english": "truly the bread of children,",
      "start": 9.07,
      "end": 13.79
    },
    {
      "latin": "Non mitténdus cánibus.",
      "english": "not to be cast to the dogs.",
      "start": 13.79,
      "end": 18.6
    },
    {
      "latin": "In figúris præsignátur,",
      "english": "In figures it is foreshown,",
      "start": 19.45,
      "end": 24.02
    },
    {
      "latin": "Cum Ísaac immolátur,",
      "english": "when Isaac is offered,",
      "start": 24.17,
      "end": 28.61
    },
    {
      "latin": "Agnus Paschæ deputátur,",
      "english": "the Paschal Lamb appointed,",
      "start": 28.62,
      "end": 33.47
    },
    {
      "latin": "Datur manna pátribus.",
      "english": "manna given to the fathers.",
      "start": 33.47,
      "end": 38.24
    },
    {
      "latin": "Bone pastor, panis vere,",
      "english": "Good Shepherd, true Bread,",
      "start": 39.11,
      "end": 44.19
    },
    {
      "latin": "Jesu, nostri miserére:",
      "english": "Jesus, have mercy on us;",
      "start": 44.19,
      "end": 49.79
    },
    {
      "latin": "Tu nos pasce, nos tuére,",
      "english": "do Thou feed us, defend us,",
      "start": 49.79,
      "end": 54.25
    },
    {
      "latin": "Tu nos bona fac vidére",
      "english": "do Thou make us see good things",
      "start": 54.25,
      "end": 58.64
    },
    {
      "latin": "In terra vivéntium.",
      "english": "in the land of the living.",
      "start": 58.77,
      "end": 63.56
    },
    {
      "latin": "Tu qui cuncta scis et vales,",
      "english": "Thou who knowest and canst all things,",
      "start": 64.27,
      "end": 69.37
    },
    {
      "latin": "Qui nos pascis hic mortáles:",
      "english": "who feedest us here as mortals,",
      "start": 69.42,
      "end": 74.85
    },
    {
      "latin": "Tuos ibi commensáles,",
      "english": "Thy fellow guests there,",
      "start": 74.85,
      "end": 79.21
    },
    {
      "latin": "Coherédes et sodáles",
      "english": "fellow heirs and companions",
      "start": 79.21,
      "end": 83.68
    },
    {
      "latin": "Fac Sanctórum civium.",
      "english": "make us of the holy citizens.",
      "start": 83.85,
      "end": 88.62
    },
    {
      "latin": "Amen.",
      "english": "Amen.",
      "start": 89.49,
      "end": 95.8
    }
  ]
}
