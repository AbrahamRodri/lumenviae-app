      "start": 124.55,
      "end": 130.57
    },
    {
      "latin": "Tulítque prædam tártari.",
      "english": "and took away the prey of hell.",
      "start": 130.57,
      "end": 137.74
    },
    {
      "latin": "O Crux ave, spes única,",
      "english": "Hail, O Cross, our only hope!",
      "start": 139.35,
      "end": 145.91
    },
    {
