      "start": 74.95,
      "end": 82.16
    },
    {
      "latin": "Arbor decóra et fúlgida,",
      "english": "O Tree, beautiful and shining,",
      "start": 84.11,
      "end": 90.69
    },
    {
      "latin": "Ornáta Regis púrpura,",
      "english": "adorned with the purple of the King,",
      "start": 90.69,
      "end": 96.5
    },
    {
      "latin": "Elécta digno stípite",
      "english": "chosen from a worthy stock",
      "start": 96.61,
      "end": 102.59
    },
    {
      "latin": "Tam sancta membra tángere.",
      "english": "to touch limbs so holy.",
      "start": 102.59,
      "end": 109.82
    },
    {
      "latin": "Beáta, cujus bráchiis",
      "english": "Blessed Tree, upon whose arms",
      "start": 111.43,
      "end": 118.32
    },
    {
      "latin": "Prétium pepéndit sǽculi:",
      "english": "hung the ransom of the world;",
      "start": 118.35,
      "end": 123.8
    },
    {
