    {
      "latin": "regnat vivus.",
      "english": "reigns alive.",
      "start": 37.3,
      "end": 41.24
    },
    {
      "latin": "Dic nobis María, quid vidísti",
      "english": "Tell us, Mary, what didst thou see",
      "start": 42.29,
      "end": 47.57
    },
    {
      "latin": "in via?",
      "english": "on the way?",
      "start": 47.57,
      "end": 51.06
    },
    {
      "latin": "Sepúlcrum Christi vivéntis,",
      "english": "The tomb of the living Christ,",
      "start": 51.49,
      "end": 56.35
    },
    {
      "latin": "et glóriam vidi resurgéntis:",
      "english": "and I saw the glory of His rising;",
      "start": 56.35,
      "end": 61.98
    },
    {
      "latin": "Angélicos testes, sudárium, et vestes.",
      "english": "the angelic witnesses, the napkin, and the garments.",
      "start": 62.39,
      "end": 70.84
    },
    {
      "latin": "Surréxit Christus spes mea:",
      "english": "Christ my hope is risen;",
      "start": 71.99,
      "end": 76.71
    },
    {
      "latin": "præcédet suos in Galilǽam.",
      "english": "He will go before His own into Galilee.",
      "start": 76.71,
      "end": 82.62
    },
