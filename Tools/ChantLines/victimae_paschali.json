      "start": 21.35,
      "end": 24.68
    },
    {
      "latin": "Mors et vita duéllo conflixére mirándo:",
      "english": "Death and life have contended in a wondrous combat;",
      "start": 25.43,
      "end": 33.65
    },
    {
