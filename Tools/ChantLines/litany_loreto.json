      "start": 636.47,
      "end": 641.63
    },
    {
      "latin": "Et concépit de Spíritu Sancto.",
      "english": "And she conceived of the Holy Ghost.",
      "start": 641.63,
      "end": 647.03
    },
    {
      "latin": "Orémus.",
      "english": "Let us pray.",
      "start": 647.03,
      "end": 650.35
    },
    {
      "latin": "Deus, qui de beátæ Maríæ Vírginis útero Verbum tuum, Ángelo nuntiánte, carnem suscípere voluísti:",
      "english": "O God, who didst will that Thy Word, at the message of an Angel, should take flesh in the womb of the Blessed Virgin Mary:",
      "start": 650.35,
      "end": 660.93
    },
    {
      "latin": "præsta supplícibus tuis; ut, qui vere eam Genitrícem Dei crédimus,",
      "english": "grant to us Thy suppliants, that we who believe her to be truly the Mother of God",
      "start": 660.93,
      "end": 669.07
    },
    {
      "latin": "ejus apud te intercessiónibus adjuvémur.",
      "english": "may be helped by her intercession with Thee.",
      "start": 669.07,
      "end": 675.5
    },
    {
      "latin": "Per eumdem Christum Dóminum nostrum.",
      "english": "Through the same Christ our Lord.",
      "start": 675.55,
      "end": 681.5
    },
    {
      "latin": "Amen.",
      "english": "Amen.",
      "start": 681.65,
      "end": 685.74
    },
    {
      "latin": "Post partum, Virgo, invioláta permansísti.",
      "english": "After childbirth, O Virgin, thou didst remain inviolate.",
      "start": 687.47,
      "end": 693.41
    },
    {
      "latin": "Dei Génitrix, intercéde pro nobis.",
      "english": "O Mother of God, intercede for us.",
      "start": 693.41,
      "end": 699.11
    },
    {
      "latin": "Orémus.",
      "english": "Let us pray.",
      "start": 699.11,
      "end": 702.19
    },
    {
      "latin": "Deus, qui salútis ætérnæ, beátæ Maríæ virginitáte fecúnda, humáno géneri prǽmia præstitísti:",
      "english": "O God, who by the fruitful virginity of Blessed Mary hast bestowed upon mankind the rewards of eternal salvation;",
      "start": 702.19,
      "end": 711.51
    },
    {
      "latin": "tríbue, quǽsumus; ut ipsam pro nobis intercédere sentiámus,",
      "english": "grant, we beseech Thee, that we may know the help of her intercession,",
      "start": 711.51,
      "end": 718.89
    },
    {
      "latin": "per quam merúimus auctórem vitæ suscípere, Dóminum nostrum Jesum Christum Fílium tuum.",
      "english": "through whom we were made worthy to receive the Author of life, our Lord Jesus Christ, Thy Son.",
      "start": 718.89,
      "end": 728.4
    },
    {
      "latin": "Amen.",
      "english": "Amen.",
      "start": 728.43,
      "end": 733.2
    },
    {
      "latin": "Gaude et lætáre, Virgo María, allelúia.",
      "english": "Rejoice and be glad, O Virgin Mary, alleluia.",
      "start": 734.63,
      "end": 740.21
    },
    {
      "latin": "Quia surréxit Dóminus vere, allelúia.",
      "english": "For the Lord is truly risen, alleluia.",
      "start": 740.21,
      "end": 745.73
    },
    {
      "latin": "Orémus.",
      "english": "Let us pray.",
      "start": 745.73,
      "end": 748.75
    },
    {
      "latin": "Deus, qui per resurrectiónem Fílii tui Dómini nostri Jesu Christi mundum lætificáre dignátus es:",
      "english": "O God, who by the Resurrection of Thy Son, our Lord Jesus Christ, didst vouchsafe to give joy to the world;",
      "start": 748.75,
      "end": 758.01
    },
    {
      "latin": "præsta, quǽsumus; ut per ejus Genitrícem Vírginem Maríam perpétuæ capiámus gáudia vitæ.",
      "english": "grant, we beseech Thee, that through His Mother, the Virgin Mary, we may obtain the joys of everlasting life.",
      "start": 758.01,
      "end": 770.15
    },
    {
      "latin": "Per eumdem Christum Dóminum nostrum.",
      "english": "Through the same Christ our Lord.",
      "start": 770.15,
      "end": 775.87
    },
    {
      "latin": "Amen.",
      "english": "Amen.",
      "start": 775.87,
      "end": 779.82
    }
  ]
}
