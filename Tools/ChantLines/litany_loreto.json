      "end": 599.25
    },
    {
      "latin": "Orémus.",
      "english": "Let us pray.",
      "start": 599.25,
      "end": 602.31
    },
    {
      "latin": "Concéde nos fámulos tuos, quǽsumus Dómine Deus, perpétua mentis et córporis sanitáte gaudére:",
      "english": "Grant, we beseech Thee, O Lord God, unto us Thy servants, that we may rejoice in continual health of mind and body,",
      "start": 602.31,
      "end": 611.83
    },
    {
      "latin": "et gloriósa beátæ Maríæ semper Vírginis intercessióne,",
      "english": "and by the glorious intercession of Blessed Mary, ever virgin,",
      "start": 611.83,
      "end": 618.37
    },
    {
      "latin": "a præsénti liberári tristítia, et ætérna pérfrui lætítia.",
      "english": "may be delivered from present sadness, and enter into the joy of Thine eternal gladness.",
      "start": 618.37,
      "end": 625.73
    },
    {
      "latin": "Per Christum Dóminum nostrum.",
      "english": "Through Christ our Lord.",
      "start": 625.73,
