    "\"Pray without ceasing. In all things give thanks; for this is the will of God in Christ Jesus concerning you.\"" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Oren sin cesar. Den gracias en toda ocasión, porque esta es la voluntad de Dios en Cristo Jesús respecto de ustedes.\""
          }
        }
      }
    },
