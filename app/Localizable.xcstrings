    },
    "A litany is a prayer of short petitions, each answered by the same response." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una letanía es una oración de peticiones breves, cada una con la misma respuesta."
          }
        }
      }
    },
    "A little quiet, and nothing else asked of you." : {
      "comment" : "Daily prayer reminder notification for readers drawn by peace and stillness: its text under the title. Warm and inviting, never scolding; under about 75 characters",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poco de silencio, y nada más se te pide."
