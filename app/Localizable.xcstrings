        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrégate por completo a María —cuerpo y alma, bienes y méritos, sin reserva y para siempre— para pertenecer por completo a Jesús por medio de ella."
          }
        }
      }
    },
