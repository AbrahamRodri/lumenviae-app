    "Matins" : {
      "comment" : "Hours of Prayer: the Church's traditional English name for an hour of the Divine Office, shown small under its plain name",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maitines"
          }
        }
      }
    },
    "May each prayer bring you stillness. Today's mysteries are ready when you are." : {
      "comment" : "Onboarding, last slide: closing line for a reader who came for peace",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que cada oración te traiga paz. Los misterios de hoy te esperan cuando quieras."
          }
        }
      }
    },
    "May is Mary's month" : {
      "comment" : "Daily prayer reminder notification in May, the month of Mary: its title, shown in bold. Warm and inviting, never scolding; under about 35 characters",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mayo es el mes de María"
          }
        }
      }
    },
    "Meditation" : {
      "comment" : "Lock Screen: the title shown when the recording playing has no title of its own\nSearch, the best match card: small capitals saying what kind of thing the match is\nStrand margin, said aloud: the bead is named for the meditation being read\nThe title shown for a meditation that has no title and no mystery",
      "localizations" : {
