    },
    "A hundred and fifty days in a row: one for each Hail Mary of the full Rosary, Our Lady's Psalter." : {
      "comment" : "Streak milestone: the line of blessing shown when it is reached, saying what the run of days means",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciento cincuenta días seguidos: uno por cada avemaría del Rosario completo, el Salterio de Nuestra Señora."
          }
        }
      }
    },
    "A light in the dark of the year" : {
      "comment" : "Daily prayer reminder notification in Advent: its title, shown in bold. Warm and inviting, never scolding; under about 35 characters",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
