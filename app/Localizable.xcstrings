    "Monday" : {
      "comment" : "A day a set of mysteries is prayed, in a comma-separated list under its name, like Monday, Thursday; capitalized as a day name in English",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "lunes"
          }
        }
      }
    },
    "Montfort calls it an easy, short, perfect and secure way to union with Our Lord. What follows is his teaching, a part at a time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montfort lo llama un camino fácil, corto, perfecto y seguro para llegar a la unión con Nuestro Señor. Lo que sigue es su enseñanza, parte por parte."
          }
        }
      }
    },
