      }
    },
    "Open a mystery to see its meditation sets, each under its own painting. The filter button shows only the kinds you choose, and a set you pin stays at the top. You can read each meditation, or listen when a set has narration." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un misterio para ver sus series de meditaciones, cada una bajo su pintura. El botón de filtro muestra solo los tipos que elijas, y una serie que fijes se queda arriba. Puedes leer cada meditación, o escucharla cuando la serie tiene narración."
          }
        }
      }
    },
    "Open day %lld" : {
      "comment" : "Consecration day overview: the act opening another day of the 33 than today",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir el día %lld"
          }
        }
      }
    },
    "Open on Verbum Gloriae's Site" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir en el sitio de Verbum Gloriae"
          }
        }
      }
    },
    "Open the Consecration" : {
      "comment" : "Chapel focus block: the gold act under the next daily prayer's name, for the consecration before it has begun",
      "localizations" : {
